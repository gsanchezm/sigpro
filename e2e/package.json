{
  "name": "@sigpro/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test --project=desktop",
    "e2e:responsive": "playwright test --project=desktop --project=tablet --project=mobile --workers=2 tests/responsive",
    "screens": "playwright test --project=screens",
    "mobile": "playwright test -c playwright.mobile.config.ts --project=mobile",
    "mobile:screens": "playwright test -c playwright.mobile.config.ts --project=mobile-screens",
    "install:browsers": "playwright install chromium",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
