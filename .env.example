# --- Base de datos (docker compose up -d db) ---
DATABASE_URL="postgresql://sigpro:sigpro@localhost:5432/sigpro?schema=public"

# --- API (apps/api) ---
PORT=3000
JWT_SECRET="dev-only-change-me"
ADMIN_KEY="dev-admin-key"
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"
# Crea los tenants y el seed la primera vez que arranca la API
SEED_ON_BOOT=true
# Número de tenants de alumno (alumno01…alumnoNN) además de `demo`
SEED_STUDENT_TENANTS=25
# Protege /api/docs con basic auth (usuario:contraseña). Vacío = sin protección
DOCS_BASIC_AUTH=
# Entorno que se muestra en la pantalla de acceso y activa el panel de usuarios de prueba
APP_ENV=dev
# Defectos plantados del laboratorio (solo instructor): activos por defecto; `false` deja la aplicación «limpia»
PLANTED_BUGS=true
# Intervalo (ms) del simulador del panel de misión; solo emite a tenants con algún cliente conectado. 0 = desactivado
SIMULATOR_MS=4000

# --- Endurecimiento de los despliegues del curso (opcional; sin estas variables todo es como siempre) ---
# Ver docs/DEPLOY-RENDER.md («Endurecimiento del despliegue del curso»).
# Semilla SECRETA (≥ 16 caracteres): los tenants de alumno pasan a ser alumno07-k4x9ab. Vacía = sin sufijos
# TENANT_SUFFIX_SEED=
# Caracteres del sufijo (3–12)
# TENANT_SUFFIX_LENGTH=6
# false: credenciales de demo y lista de tenants solo con sesión o X-Admin-Key
# LAB_PUBLIC=true
# true: register / forgot / resend solo admiten correos de los dominios de ALLOWED_EMAIL_DOMAINS (422 al resto)
# RESTRICT_EMAIL_DOMAINS=false
# ALLOWED_EMAIL_DOMAINS=sigpro.lab,sigpro.test,example.com
# true: X-Robots-Tag: noindex, nofollow en todas las respuestas de la API
# ROBOTS_NOINDEX=false

# --- Web (apps/web) ---
VITE_API_URL="http://localhost:3000/api"
VITE_TENANT=demo
# Variables de COMPILACIÓN de la web (cambiarlas obliga a reconstruirla)
# false: /lab exige sesión; sin lista de tenants, sin la contraseña del alumno y sin el zip del material
# VITE_LAB_PUBLIC=true
# true: robots.txt con Disallow total y <meta name="robots" content="noindex">
# VITE_NOINDEX=false
