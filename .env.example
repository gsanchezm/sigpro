# --- Base de datos (docker compose up -d db) ---
DATABASE_URL="postgresql://sigpro:sigpro@localhost:5432/sigpro?schema=public"

# --- API (apps/api) ---
PORT=3000
JWT_SECRET="dev-only-change-me"
ADMIN_KEY="dev-admin-key"
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"
# Crea los tenants y el seed la primera vez que arranca la API
SEED_ON_BOOT=true
# Número de tenants de alumno (alumno01…alumnoNN) además de `demo`
SEED_STUDENT_TENANTS=25
# Protege /api/docs con basic auth (usuario:contraseña). Vacío = sin protección
DOCS_BASIC_AUTH=
# Entorno que se muestra en la pantalla de acceso y activa el panel de usuarios de prueba
APP_ENV=dev
# Defectos plantados del laboratorio (solo instructor): activos por defecto; `false` deja la aplicación «limpia»
PLANTED_BUGS=true
# Intervalo (ms) del simulador del panel de misión; solo emite a tenants con algún cliente conectado. 0 = desactivado
SIMULATOR_MS=4000

# --- Web (apps/web) ---
VITE_API_URL="http://localhost:3000/api"
VITE_TENANT=demo
