# Copia este archivo a `.env` y ajusta los valores. Todo es opcional: sin `.env` la suite apunta a SIGPRO en local.

# Tu usuario de alumno (alumno01 … alumno25). Es a la vez el correo `alumnoNN@sigpro.lab` y el tenant donde trabajas.
SIGPRO_STUDENT=alumno01

# Solo si quieres usar un tenant distinto al de tu usuario (p. ej. `demo` para curiosear sin pisar tus datos)
# SIGPRO_TENANT=alumno01

# Contraseña de tu usuario de alumno (la misma para todos)
# SIGPRO_STUDENT_PASSWORD=Alumno1234!

# Dónde corre SIGPRO. Por defecto, tu máquina (docker compose + pnpm dev):
SIGPRO_WEB_URL=http://localhost:5173
SIGPRO_API_URL=http://localhost:3000/api

# Contra el entorno del curso en Render:
# SIGPRO_WEB_URL=https://sigpro-web.onrender.com
# SIGPRO_API_URL=https://sigpro-api.onrender.com/api
