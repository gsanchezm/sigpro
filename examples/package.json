{
  "name": "sigpro-playwright-examples",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Proyecto de referencia Playwright + TypeScript contra SIGPRO: fixtures por rol, Page Object y un spec por sesión del curso",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "browsers": "playwright install chromium",
    "reset": "tsx scripts/reset-tenant.ts",
    "test": "playwright test --project=chromium",
    "test:fresh": "npm run reset && playwright test --project=chromium",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
