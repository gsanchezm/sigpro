{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "SIGPRO API — NestJS + Prisma + PostgreSQL",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "node scripts/run-with-env.mjs nest start --watch",
    "start": "node scripts/run-with-env.mjs node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/run-with-env.mjs prisma migrate dev",
    "prisma:deploy": "node scripts/run-with-env.mjs prisma migrate deploy",
    "seed": "node scripts/run-with-env.mjs tsx src/seed/cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@prisma/client": "6.19.3",
    "@sigpro/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
